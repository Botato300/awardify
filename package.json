		"@types/node": "^26.6.5",
		"daisyui": "^5.7.50",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#assets/*": "./assets/*"
	}
}