{
	"name": "awardify",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">= 22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
